{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "App: Streamlit",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "src/app.py",
                "--server.port=8501",
                "--server.runOnSave=true"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "jinja": true,
            "justMyCode": true
        }
    ]
}